# Built application: npm start, then open http://127.0.0.1:3000
# Development: npm run dev, then open http://localhost:5173
API_PORT=3000

# Leave empty to keep notes/progress outside the checkout:
# Windows: %LOCALAPPDATA%\PointNemo\point-nemo.sqlite
# A custom relative path is resolved against the project root.
DATABASE_PATH=

# Local inference only. Set these in the actual Ollama process and restart it.
OLLAMA_NO_CLOUD=1
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Install with: ollama pull qwen2.5:3b
# Optional faster model: qwen2.5:1.5b; measured reliability is lower.
OLLAMA_KEEP_ALIVE=30m
# Experimental model-based review can produce false rejections on small models.
OLLAMA_REVIEW=0
# Optional reproducible generation; leave unset for fresh sampling per job.
# OLLAMA_SEED=42
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_INPUT_TOKENS=4096
OLLAMA_MAX_OUTPUT_TOKENS=3072
INFERENCE_TIMEOUT_MS=180000
JOB_TIMEOUT_MS=360000

# OPENAI_API_KEY is used only by the optional development asset-generation tool.
OPENAI_API_KEY=
